{
  "identifier": "default",
  "description": "Default capabilities for Jarvis",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "process:allow-exit"
  ]
}
